@using NetflixHome.ClassLogic

<div class="carrusel-banner" style="background-image: linear-gradient(180deg, rgba(4,6,20,0.15) 0%, rgba(4,6,20,0.35) 55%, #04060f 100%), url('@Destacada.ImagenUrl');">
	<div class="banner-contenido">
		<h1 class="banner-titulo">@Destacada.Titulo</h1>
		<div class="banner-meta">
			<span class="badge-original">ORIGINAL</span>
			<span class="banner-year">@Destacada.Year</span>
			<span class="banner-punto">•</span>
			<span>4K Ultra HD</span>
		</div>

		<div class="banner-acciones">
			<button class="btn-play" type="button">
				<span class="icono-play">▶</span> Reproducir
			</button>
			<button class="btn-info" type="button">
				<span class="icono-info">+</span> Más información
			</button>
			<button class="btn-agregar" type="button" title="Añadir a Mi Lista">+</button>
		</div>
	</div>

	<div class="banner-fade-inferior"></div>
</div>

@code {
	Pelicula Destacada => PeliculasRepository.Destacada;
}
