@page "/"
@using NetflixHome.ClassLogic
@implements IDisposable
@inject PeliculasApiClient ApiClient
@inject ToastService Toast
@inject BusquedaService Busqueda
@inject IJSRuntime JS

@if (Todas is null)
{
	<p class="dplus-cargando">Cargando catálogo...</p>
}
else if (!string.IsNullOrWhiteSpace(textoBusqueda))
{
	<div class="dplus-resultados-busqueda">
		@if (Resultados.Count == 0)
		{
			<div class="busqueda-vacia">
				<span class="busqueda-vacia-icono">🔍</span>
				<h2>No encontramos resultados para "@textoBusqueda"</h2>
				<p>Prueba con otro título, o revisa que esté bien escrito.</p>
			</div>
		}
		else
		{
			<h2 class="busqueda-titulo">Resultados para "@textoBusqueda"</h2>
			<div class="busqueda-grid">
				@foreach (var pelicula in Resultados)
				{
					<PeliculaCard Id="@pelicula.Id" Titulo="@pelicula.Titulo" ImagenUrl="@pelicula.ImagenUrl"
								  Year="@pelicula.Year" Etiqueta="@pelicula.Etiqueta" />
				}
			</div>
		}
	</div>
}
else
{
	<Carrusel Destacada="@Destacada" OnReproducir="MostrarToastReproducir" />

	<div class="filas-home">
		<ListaPeliculas TituloFila="Populares en Jhayla+" Peliculas="@Populares" />
		<ListaPeliculas TituloFila="Recomendado para ti" Peliculas="@Recomendadas" />

		<PromoBanner OnSuscribir="MostrarToastSuscripcion" Peliculas="@Todas" />

		<FilaColeccion TituloChico="JHAYLA+ COLLECTION" TituloGrande="Próximamente"
					   Descripcion="Los próximos estrenos que se vienen a Jhayla+."
					   Peliculas="@Proximamente" />

		<ListaPeliculas TituloFila="Más para ver" Peliculas="@MasParaVer" />

		<FilaColeccion TituloChico="JHAYLA+ COLLECTION" TituloGrande="Tendencias ahora"
					   Descripcion="Lo que todos están viendo esta semana."
					   Peliculas="@Tendencias" />
	</div>
}

@code {

	private List<Peliculas>? Todas;

	private List<Peliculas> Populares => Todas?.Take(7).ToList() ?? new();

	// Si el catálogo tiene pocas películas, Skip(7) puede quedar vacío:
	// en ese caso se usa el catálogo completo para no mostrar la fila vacía.
	private List<Peliculas> Proximamente => Todas is null
		? new List<Peliculas>()
		: (Todas.Skip(7).Any() ? Todas.Skip(7).ToList() : Todas);

	private List<Peliculas> Recomendadas => Todas is null
		? new List<Peliculas>()
		: Todas.AsEnumerable().Reverse().ToList();

	// Fila intercalada entre las 2 colecciones: otro orden distinto
	// para que no se repita tal cual con Populares/Recomendadas/Tendencias.
	private List<Peliculas> MasParaVer => Todas is null
		? new List<Peliculas>()
		: Todas.Skip(3).Concat(Todas.Take(3)).ToList();

	private List<Peliculas> Tendencias => Todas is null
		? new List<Peliculas>()
		: Todas.Where((p, indice) => indice % 2 == 0)
			.Concat(Todas.Where((p, indice) => indice % 2 != 0))
			.ToList();

	private Peliculas? Destacada => Todas?.FirstOrDefault(p => p.Id == 2) ?? Todas?.FirstOrDefault();

	private string textoBusqueda = string.Empty;

	private List<Peliculas> Resultados => Todas is null
		? new()
		: Todas.Where(p => (p.Titulo ?? string.Empty).Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase)).ToList();

	protected override async Task OnInitializedAsync()
	{
		Todas = await ApiClient.ObtenerTodasAsync();
		textoBusqueda = Busqueda.Texto;
		Busqueda.OnBuscar += AlBuscar;
	}

	private void AlBuscar(string texto)
	{
		textoBusqueda = texto;
		InvokeAsync(StateHasChanged);
	}

	public void Dispose()
	{
		Busqueda.OnBuscar -= AlBuscar;
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (Todas is not null)
		{
			await JS.InvokeVoidAsync("iniciarFilasScroll");
		}
	}

	private bool suscrip;

	private void MostrarToastSuscripcion()
	{
		suscrip = !suscrip;
		Toast.Mostrar(suscrip ? "Función Premium próximamente disponible" : "Podras suscribirte en 4 dias");
	}

	private bool repro;
	private void MostrarToastReproducir()
	{
		repro = !repro;
		Toast.Mostrar(repro ? "Pronto podras reproducir esta Pelicula/Serie" : "Ten paciencia");
	}
}
