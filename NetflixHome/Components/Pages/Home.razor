@page "/"
@using NetflixHome.ClassLogic

<Carrusel />

<div class="filas-home">
	<ListaPeliculas TituloFila="Añadido recientemente" />
	<ListaPeliculas TituloFila="Recomendado para ti" Peliculas="@Reordenadas" />
</div>

@code {
	// Misma fuente de datos (PeliculasRepository), solo se reordena para
	// mostrar una segunda fila distinta en la home, sin inventar películas nuevas.
	List<Pelicula> Reordenadas => PeliculasRepository.Todas.AsEnumerable().Reverse().ToList();
}
