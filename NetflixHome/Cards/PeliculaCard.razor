@using NetflixHome.ClassLogic
@implements IDisposable
@inject ToastService Toast
@inject SesionUsuario Sesion
@inject FavoritosService Favoritos
@inject NavigationManager Nav

<div class="pelicula-card @(EstiloAlterno ? "pelicula-card--alt" : "")" onclick="@AbrirDetalle">
	<div class="pelicula-card-img-wrap">
		<img src="@ImagenUrl" alt="@Titulo" loading="lazy"
			 onerror="this.onerror=null;this.src='/images/susto.png';" />

		@if (!string.IsNullOrWhiteSpace(Etiqueta))
		{
			<span class="card-etiqueta">@Etiqueta</span>
		}

		<button class="card-mas @(agregada ? "card-mas--agregada" : "")" type="button"
				title="@(agregada ? "Quitar de Mi Lista" : "Añadir a Mi Lista")"
				onclick="@Agregar">
			@(agregada ? "✓" : "+")
		</button>

		<div class="pelicula-card-overlay">
			<div class="overlay-texto">
				<h3>@Titulo</h3>
				<p>@Year</p>
			</div>
		</div>
	</div>
</div>

@code {

	[Parameter]
	public int Id { get; set; }

	[Parameter]
	public string? Titulo { get; set; }

	[Parameter]
	public string? ImagenUrl { get; set; }

	[Parameter]
	public int Year { get; set; }

	[Parameter]
	public bool EstiloAlterno { get; set; }

	[Parameter]
	public string? Etiqueta { get; set; }

	private bool agregada;

	protected override void OnInitialized()
	{
		agregada = Favoritos.EsFavorita(Id);
		Favoritos.OnCambio += AlCambiarFavoritos;
	}

	private void AlCambiarFavoritos()
	{
		var nuevoEstado = Favoritos.EsFavorita(Id);
		if (nuevoEstado != agregada)
		{
			agregada = nuevoEstado;
			InvokeAsync(StateHasChanged);
		}
	}

	private async Task Agregar()
	{
		if (!Sesion.HaIniciadoSesion)
		{
			Toast.Mostrar("Inicia sesión para guardar películas en Mi Lista");
			Nav.NavigateTo("/InicioSesion");
			return;
		}

		var exito = await Favoritos.AlternarAsync(Id);
		if (!exito)
		{
			Toast.Mostrar("No se pudo actualizar Mi Lista. Intenta de nuevo.");
			return;
		}

		agregada = Favoritos.EsFavorita(Id);
		Toast.Mostrar(agregada ? "Agregada a Mi Lista correctamente" : "Removida de Mi Lista correctamente");
	}

	private void AbrirDetalle()
	{
		if (!Sesion.HaIniciadoSesion)
		{
			Toast.Mostrar("Inicia sesión para ver los detalles de esta película");
			Nav.NavigateTo("/InicioSesion");
			return;
		}

		Nav.NavigateTo($"/pelicula/{Id}");
	}

	public void Dispose()
	{
		Favoritos.OnCambio -= AlCambiarFavoritos;
	}
}
