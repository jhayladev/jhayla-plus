@using NetflixHome.ClassLogic
@if (Peliculas == null)
{
	<p>Cargando peliculas, espere un momento...</p>
}
else if (Peliculas.Count == 0)
{
	<p>No hay peliculas para mostrar.</p>
}
else
{
	<section class="fila-seccion">
		<h2 class="fila-titulo">@TituloFila</h2>
		<div class="fila-envoltura">
			<div class="fila-fade-izquierda"></div>
			<div class="fila-peliculas">
				@foreach (var pelicula in Peliculas)
				{
					<PeliculaCard Id="@pelicula.Id" Titulo="@pelicula.Titulo" ImagenUrl="@pelicula.ImagenUrl" Year="@pelicula.Year"
								  EstiloAlterno="@EstiloAlterno" Etiqueta="@(Etiqueta ?? pelicula.Etiqueta)"></PeliculaCard>
				}
			</div>
			<div class="fila-fade-derecha">
				<span class="fila-flecha">›</span>
			</div>
		</div>
	</section>
}


@code {

	[Parameter]
	public string TituloFila { get; set; } = "Añadido recientemente";

	[Parameter]
	public List<Peliculas>? Peliculas { get; set; }

	[Parameter]
	public bool EstiloAlterno { get; set; }

	// Badge opcional mostrado en cada card cuando EstiloAlterno es true.
	[Parameter]
	public string? Etiqueta { get; set; }

	protected override void OnInitialized()
	{
		Peliculas ??= PeliculasRepository.Todas;
	}
}
