<div class="auth-fondo">
	<div class="auth-brillo auth-brillo-1"></div>
	<div class="auth-brillo auth-brillo-2"></div>
	<div class="auth-brillo auth-brillo-3"></div>

	<div class="auth-tarjeta">
		<a class="auth-logo" href="/">
			Jhayla<span class="auth-logo-signo">+</span>
		</a>

		<h1 class="auth-titulo">@Titulo</h1>
		<p class="auth-subtitulo">@Subtitulo</p>

		@Cuerpo

		@if (PieDePagina is not null)
		{
			<div class="auth-pie">
				@PieDePagina
			</div>
		}
	</div>
</div>

@code {
	[Parameter] public string Titulo { get; set; } = string.Empty;
	[Parameter] public string Subtitulo { get; set; } = string.Empty;
	[Parameter] public RenderFragment? Cuerpo { get; set; }
	[Parameter] public RenderFragment? PieDePagina { get; set; }
}
